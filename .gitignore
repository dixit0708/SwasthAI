# Environment variables
.env
.env.*
!.env.example

# Python virtual environments
venv/
.venv/
env/

# Python compiled files and caches
__pycache__/
*.py[cod]
*$py.class

# Pytest and coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
nosetests.xml
coverage.xml

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Type checking and linting caches
.mypy_cache/
.ruff_cache/
.pylint.d/

# ML Pipeline Data and Models
ml-services/*/data/*
!ml-services/*/data/README.md
ml-services/*/models/
ml-services/*/checkpoints/
ml_pipeline/*/data/
ml_pipeline/*/models/

# Local Storage (Medical images, reports, prescriptions)
storage/reports/*
!storage/reports/.gitkeep
storage/medical_images/*
!storage/medical_images/.gitkeep
storage/prescriptions/*
!storage/prescriptions/.gitkeep

# Temporary files
*.tmp
*.temp
/tmp/

# Claude Code tooling (local agent/skill config, not part of the app)
.claude/
.agents/
.impeccable/
skills-lock.json
refine.py
