# Environment variables
.env
.env.*
!.env.example

# Python virtual environments
venv/
.venv/
env/

# Python compiled files and caches
__pycache__/
*.py[cod]
*$py.class

# Pytest and coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
nosetests.xml
coverage.xml

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Type checking and linting caches
.mypy_cache/
.ruff_cache/
.pylint.d/

# ML Pipeline Data and Models
ml-services/*/data/*
!ml-services/*/data/README.md
ml-services/*/models/
ml-services/*/checkpoints/
ml_pipeline/*/data/
ml_pipeline/*/models/

# Local Storage (Medical images, reports, prescriptions, documents)
storage/reports/*
!storage/reports/.gitkeep
storage/medical_images/*
!storage/medical_images/.gitkeep
storage/prescriptions/*
!storage/prescriptions/.gitkeep
storage/documents/*
!storage/documents/.gitkeep

# Filled-in consented-doctor sheets contain personal phone numbers
backend/scripts/*.csv
!backend/scripts/consented_doctors_template.csv

# Raw datasets and temporary scratch files
*.XPT
*.xpt
nhanes_liver_raw.csv
scratch/

# Filled-in consented-doctor sheets contain personal phone numbers
backend/scripts/*.csv
!backend/scripts/consented_doctors_template.csv

# Temporary files
*.tmp
*.temp
/tmp/

# Playwright E2E test tooling (tests/e2e/diabetes.spec.js) — package.json/
# playwright.config.js are test-only infra kept in the repo, but their
# runtime output/deps are not.
node_modules/
test-results/
playwright-report/
blob-report/
.playwright-mcp/

# Claude Code tooling (local agent/skill config, not part of the app)
.claude/
.agents/
.impeccable/
skills-lock.json
refine.py
.mcp.json
